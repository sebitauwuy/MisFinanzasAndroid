<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/finance_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_financial_summary_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Mis finanzas" android:textSize="16sp" android:textStyle="bold"
            android:textColor="#FFFFFF" />
        <TextView android:id="@+id/finance_widget_month" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Mes actual"
            android:textSize="11sp" android:textColor="#B5CFC5" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Saldo disponible"
        android:textSize="12sp" android:textColor="#B5CFC5"/>
    <TextView android:id="@+id/finance_widget_balance"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="••••••" android:textSize="27sp" android:textStyle="bold"
        android:textColor="#9FE5C3" android:maxLines="1" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Gastos del mes" android:textSize="11sp" android:textColor="#B5CFC5"/>
            <TextView android:id="@+id/finance_widget_expenses"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="••••" android:textStyle="bold" android:textSize="16sp"
                android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Falta pagar" android:textSize="11sp" android:textColor="#B5CFC5"/>
            <TextView android:id="@+id/finance_widget_pending"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="••••" android:textStyle="bold" android:textSize="16sp"
                android:textColor="#FFB4A6" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Disponible tras pagos"
            android:textSize="11sp" android:textColor="#B5CFC5"/>
        <TextView android:id="@+id/finance_widget_projected"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="••••••" android:textStyle="bold" android:textSize="17sp"
            android:textColor="#9FE5C3" android:maxLines="1"/>
    </LinearLayout>
    <TextView android:id="@+id/finance_widget_privacy"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Importes ocultos"
        android:textSize="10sp" android:textColor="#B5CFC5"/>
</LinearLayout>
